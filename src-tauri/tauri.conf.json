{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foxy Jumpscare",
  "version": "0.2.0",
  "identifier": "com.foxy.jumpscare",
  "build": {
    "frontendDist": "../out",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Foxy Jumpscare",
        "width": 800,
        "height": 600,
        "resizable": false,
        "maximized": true,
        "visible": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
